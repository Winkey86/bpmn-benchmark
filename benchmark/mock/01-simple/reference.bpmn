<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions" targetNamespace="urn:bpmn-benchmark:mock" exporter="synthetic-mock">
  <bpmn:collaboration id="Collaboration">
    <bpmn:participant id="Participant" name="MOCK 01-simple" processRef="Process" />
  </bpmn:collaboration>
  <bpmn:process id="Process" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="lane_0" name="Сотрудник">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>create</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_1" name="Руководитель">
        <bpmn:flowNodeRef>review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>notify</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="lane_2" name="Администратор">
        <bpmn:flowNodeRef>grant</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Нужен доступ" />
    <bpmn:userTask id="create" name="Подать заявку" />
    <bpmn:userTask id="review" name="Рассмотреть заявку" />
    <bpmn:exclusiveGateway id="decision" name="Заявка одобрена?" default="flow_5" />
    <bpmn:userTask id="grant" name="Предоставить доступ" />
    <bpmn:endEvent id="success" name="Доступ предоставлен" />
    <bpmn:userTask id="notify" name="Сообщить об отказе" />
    <bpmn:endEvent id="reject" name="Отказ получен" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="start" targetRef="create" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="create" targetRef="review" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="review" targetRef="decision" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="decision" targetRef="grant" name="Одобрено">
      <bpmn:conditionExpression language="http://www.w3.org/1999/XPath" xsi:type="bpmn:tFormalExpression">$approved = true()</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="flow_4" sourceRef="grant" targetRef="success" />
    <bpmn:sequenceFlow id="flow_5" sourceRef="decision" targetRef="notify" name="Отказ" />
    <bpmn:sequenceFlow id="flow_6" sourceRef="notify" targetRef="reject" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram">
    <bpmndi:BPMNPlane id="Plane" bpmnElement="Collaboration">
      <bpmndi:BPMNShape id="shape_Participant" bpmnElement="Participant" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="1260" height="540" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_0" bpmnElement="lane_0" isHorizontal="true">
        <dc:Bounds x="70" y="40" width="1230" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_1" bpmnElement="lane_1" isHorizontal="true">
        <dc:Bounds x="70" y="220" width="1230" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_lane_2" bpmnElement="lane_2" isHorizontal="true">
        <dc:Bounds x="70" y="400" width="1230" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_start" bpmnElement="start">
        <dc:Bounds x="192.0" y="117.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_create" bpmnElement="create">
        <dc:Bounds x="324.0" y="105.0" width="132" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_review" bpmnElement="review">
        <dc:Bounds x="504.0" y="285.0" width="132" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_decision" bpmnElement="decision">
        <dc:Bounds x="725.0" y="290.0" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_grant" bpmnElement="grant">
        <dc:Bounds x="864.0" y="465.0" width="132" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_success" bpmnElement="success">
        <dc:Bounds x="1092.0" y="477.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_notify" bpmnElement="notify">
        <dc:Bounds x="864.0" y="285.0" width="132" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="shape_reject" bpmnElement="reject">
        <dc:Bounds x="1092.0" y="117.0" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="edge_flow_0" bpmnElement="flow_0">
        <di:waypoint x="228.0" y="135.0" />
        <di:waypoint x="324.0" y="135.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_1" bpmnElement="flow_1">
        <di:waypoint x="456.0" y="135.0" />
        <di:waypoint x="480.0" y="135.0" />
        <di:waypoint x="480.0" y="315.0" />
        <di:waypoint x="504.0" y="315.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_2" bpmnElement="flow_2">
        <di:waypoint x="636.0" y="315.0" />
        <di:waypoint x="725.0" y="315.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_3" bpmnElement="flow_3">
        <di:waypoint x="775.0" y="315.0" />
        <di:waypoint x="819.5" y="315.0" />
        <di:waypoint x="819.5" y="495.0" />
        <di:waypoint x="864.0" y="495.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_4" bpmnElement="flow_4">
        <di:waypoint x="996.0" y="495.0" />
        <di:waypoint x="1092.0" y="495.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_5" bpmnElement="flow_5">
        <di:waypoint x="775.0" y="315.0" />
        <di:waypoint x="864.0" y="315.0" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="edge_flow_6" bpmnElement="flow_6">
        <di:waypoint x="996.0" y="315.0" />
        <di:waypoint x="1044.0" y="315.0" />
        <di:waypoint x="1044.0" y="135.0" />
        <di:waypoint x="1092.0" y="135.0" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>